# Copy to web/.env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
# Signing secret (whsec_…) of the Resend webhook pointed at
# https://<app>/api/webhooks/resend (events: sent, delivered, opened, bounced, complained)
RESEND_WEBHOOK_SECRET=

# SMS (Twilio — requires A2P 10DLC registration for US numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Messaging (Plan 34). In Twilio, point the number's / WhatsApp sender's
# "A message comes in" webhook to https://<app>/api/webhooks/twilio/inbound.
# Delivery status callbacks go to /api/webhooks/twilio/status automatically
# when NEXT_PUBLIC_APP_URL is https.
# WhatsApp sender, e.g. +17875550100 (the "whatsapp:" prefix is added for you)
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp Content templates (Content SID HX…), one per template and
# language. Body variables in order: rent_reminder/rent_overdue {{1}} name,
# {{2}} amount, {{3}} due date, {{4}} property; receipt {{1}} name, {{2}} amount,
# {{3}} date, {{4}} receipt no.; contract_ready_to_sign {{1}} name, {{2}} landlord,
# {{3}} property, {{4}} link; contract_signed {{1}} property; lease_ending
# {{1}} property, {{2}} days, {{3}} link. Unset = WhatsApp is skipped (SMS/email used).
TWILIO_WA_TEMPLATE_RENT_REMINDER_ES=
TWILIO_WA_TEMPLATE_RENT_REMINDER_EN=
TWILIO_WA_TEMPLATE_RENT_OVERDUE_ES=
TWILIO_WA_TEMPLATE_RENT_OVERDUE_EN=
TWILIO_WA_TEMPLATE_RECEIPT_ES=
TWILIO_WA_TEMPLATE_RECEIPT_EN=
TWILIO_WA_TEMPLATE_CONTRACT_READY_TO_SIGN_ES=
TWILIO_WA_TEMPLATE_CONTRACT_READY_TO_SIGN_EN=
TWILIO_WA_TEMPLATE_CONTRACT_SIGNED_ES=
TWILIO_WA_TEMPLATE_CONTRACT_SIGNED_EN=
TWILIO_WA_TEMPLATE_LEASE_ENDING_ES=
TWILIO_WA_TEMPLATE_LEASE_ENDING_EN=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROPIETARIO=
STRIPE_PRICE_INVERSIONISTA=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_PROPIETARIO_YEARLY=
STRIPE_PRICE_INVERSIONISTA_YEARLY=
# Free trial days on a first paid subscription (0 or unset = no trial, max 60)
STRIPE_TRIAL_DAYS=
# Where Enterprise contact-form inquiries are emailed (default hola@prcontract.online)
CONTACT_EMAIL=
STRIPE_CUSTOMER_PORTAL_URL=

# Rate limiting (Upstash Redis; falls back to in-memory when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron (Bearer token for /api/cron/*: notify, rent, lifecycle, messages)
CRON_SECRET=
# HMAC key for unsubscribe links in lifecycle emails (falls back to CRON_SECRET)
UNSUBSCRIBE_SECRET=

# AI features (Plan 39). Unset = all AI features hidden.
ANTHROPIC_API_KEY=
# Tenant lease Q&A on the signing page. Keep off until the attorney approves sample answers.
AI_LEASE_HELP=
