# Copy to web/.env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=

# SMS (Twilio — requires A2P 10DLC registration for US numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PROPIETARIO=
STRIPE_PRICE_INVERSIONISTA=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_PROPIETARIO_YEARLY=
STRIPE_PRICE_INVERSIONISTA_YEARLY=
# Free trial days on a first paid subscription (0 or unset = no trial, max 60)
STRIPE_TRIAL_DAYS=
# Where Enterprise contact-form inquiries are emailed (default hola@prcontract.online)
CONTACT_EMAIL=
STRIPE_CUSTOMER_PORTAL_URL=

# Rate limiting (Upstash Redis; falls back to in-memory when unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron (Bearer token for /api/cron/notify)
CRON_SECRET=
# HMAC key for unsubscribe links in lifecycle emails (falls back to CRON_SECRET)
UNSUBSCRIBE_SECRET=

# AI features (Plan 39). Unset = all AI features hidden.
ANTHROPIC_API_KEY=
# Tenant lease Q&A on the signing page. Keep off until the attorney approves sample answers.
AI_LEASE_HELP=
